+				vec4 clipDirection = PROJECTION_MATRIX * vec4(viewNormal, 0.0);
+				// Derivative of perspective division, then normalize in actual pixels.
+				vec2 pixelDirection = (clipDirection.xy * clipPos.w - clipPos.xy * clipDirection.w) * VIEWPORT_SIZE;
+				pixelDirection /= max(length(pixelDirection), 0.000001);
+				float facing = clamp(1.0 - abs(normalize(viewNormal).z), 0.0, 1.0);
+				float clipWidth = 0.01 * _OutlineWidth * outlineTex * _OutlineReferenceViewportHeight * min(clipPos.w, _OutlineScaledMaxDistance) * facing;

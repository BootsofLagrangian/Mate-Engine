+				float aspect = abs(nearUpperRight.y / nearUpperRight.x);
+				vec3 viewNormal = mat3(MODELVIEW_MATRIX) * NORMAL.xyz;
+				vec3 clipNormal = mat3(PROJECTION_MATRIX) * viewNormal.xyz;
